<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvSourateArabic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:fontFamily="serif"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvSourateName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Aucune sourate sélectionnée"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Player card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Seek bar -->
                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <!-- Time labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Play controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_play_button"
                        android:src="@drawable/ic_play"
                        app:tint="@color/bg" />

                </LinearLayout>

                <!-- Speed and loop row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeed"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        app:strokeColor="@color/border"
                        android:text="1.0x"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone" />

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <!-- Loop controls -->
                    <ImageButton
                        android:id="@+id/btnLoop"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_control_btn"
                        android:src="@drawable/ic_loop"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/muted" />

                    <ImageButton
                        android:id="@+id/btnLoopMinus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_control_btn"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/text" />

                    <TextView
                        android:id="@+id/tvLoopCount"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnLoopPlus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_control_btn"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/text" />

                </LinearLayout>

                <!-- Loop progress -->
                <TextView
                    android:id="@+id/tvLoopProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="1/3"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Segment mode card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Toggle row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✂ Sélection de segment"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnSegmentMode"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_control_btn"
                        android:src="@drawable/ic_cut"
                        app:tint="@color/muted" />
                </LinearLayout>

                <!-- Segment controls (hidden by default) -->
                <LinearLayout
                    android:id="@+id/layoutSegment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Start -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content"
                            android:text="Début" android:textColor="@color/muted" android:textSize="11sp" />
                        <SeekBar android:id="@+id/seekSegmentStart" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:progressTint="@color/accent3" android:thumbTint="@color/accent3" />
                        <TextView android:id="@+id/tvSegmentStart" android:layout_width="48dp"
                            android:layout_height="wrap_content" android:text="0:00"
                            android:textColor="@color/accent3" android:textSize="11sp" android:gravity="end" />
                    </LinearLayout>

                    <!-- End -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content"
                            android:text="Fin" android:textColor="@color/muted" android:textSize="11sp" />
                        <SeekBar android:id="@+id/seekSegmentEnd" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:progressTint="@color/danger" android:thumbTint="@color/danger" />
                        <TextView android:id="@+id/tvSegmentEnd" android:layout_width="48dp"
                            android:layout_height="wrap_content" android:text="0:00"
                            android:textColor="@color/danger" android:textSize="11sp" android:gravity="end" />
                    </LinearLayout>

                    <!-- Mark buttons -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMarkStart"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:text="⬅ Marquer début"
                            android:textSize="11sp" app:strokeColor="@color/accent3" android:textColor="@color/accent3" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMarkEnd"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_weight="1" android:layout_marginStart="6dp"
                            android:text="Marquer fin ➡"
                            android:textSize="11sp" app:strokeColor="@color/danger" android:textColor="@color/danger" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveVerset"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="💾 Sauvegarder comme verset"
                        app:backgroundTint="@color/accent2"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Versets list -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📋 Versets"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnAddVerset"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_control_btn"
                        android:src="@drawable/ic_add"
                        app:tint="@color/accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoVersets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Utilisez ✂ pour définir des versets"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVersets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
