<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp"
    android:background="@drawable/bg_verset_item">

    <!-- Indicateur "en lecture" animé -->
    <ImageView
        android:id="@+id/ivPlaying"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_equalizer"
        app:tint="@color/accent"
        android:visibility="gone" />

    <!-- Numéro -->
    <TextView
        android:id="@+id/tvVersetNum"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="V.1"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Mode bibliothèque : aperçu texte arabe -->
        <TextView
            android:id="@+id/tvArabicSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:textDirection="rtl"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Mode legacy : plage horaire -->
        <TextView
            android:id="@+id/tvTimeRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 → 0:00"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <!-- Statut + répétitions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="À apprendre" android:textSize="11sp" android:textColor="@color/muted" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" · " android:textColor="@color/muted" android:textSize="11sp" />
            <TextView
                android:id="@+id/tvRepeats"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0× écouté" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Boutons -->
    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="36dp" android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_control_btn"
        android:src="@drawable/ic_play"
        app:tint="@color/accent" />

    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_control_btn"
        android:src="@drawable/ic_delete"
        app:tint="@color/danger" />

</LinearLayout>
