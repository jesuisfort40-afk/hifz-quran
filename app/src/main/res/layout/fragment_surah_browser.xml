<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Bibliothèque du Coran"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Récitateur chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipReciter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️ Mishary Alafasy"
            android:textColor="@color/accent"
            app:chipBackgroundColor="@color/surface"
            app:chipStrokeColor="@color/accent"
            app:chipStrokeWidth="1dp"
            android:layout_marginBottom="12dp" />

        <!-- Recherche -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rechercher une sourate…"
            app:boxBackgroundColor="@color/surface"
            app:boxStrokeColor="@color/accent"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:inputType="text"
                android:imeOptions="actionSearch" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Compteur résultats -->
        <TextView
            android:id="@+id/tvResultCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="114 sourates"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- ── Barre de progression import ── -->
    <ProgressBar
        android:id="@+id/progressImport"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvImportStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:paddingHorizontal="16dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- ── Liste des 114 sourates ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBrowser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />

</LinearLayout>
