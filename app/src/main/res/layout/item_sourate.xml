<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardBg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvArabicName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بِسْمِ اللَّهِ"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:alpha="0.8" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sourate"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tvVersets" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" · " android:textColor="#99FFFFFF" android:textSize="12sp" />
                <TextView android:id="@+id/tvDate" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_play_button_white"
            android:src="@drawable/ic_play"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_control_btn"
            android:src="@drawable/ic_delete"
            app:tint="#FF6666" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
