<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Numéro -->
        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_control_btn"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="1" />

        <!-- Infos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفاتحة"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:fontFamily="serif"
                android:textDirection="rtl" />

            <TextView
                android:id="@+id/tvLatin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Al-Fatiha"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/tvFr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L'Ouverture"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvVerseCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 versets"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvJuz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Juz 1"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <!-- Badge "Déjà importée" — visible seulement si importée -->
                <TextView
                    android:id="@+id/tvImportedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · ✓ Importée"
                    android:textColor="#4CAF50"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>

        <!-- Bouton ajouter / déjà importé -->
        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_play_button"
            android:src="@drawable/ic_add"
            app:tint="@color/bg" />

    </LinearLayout>
</androidx.cardview.widget.CardView>